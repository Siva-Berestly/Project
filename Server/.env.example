# Server Environment Variables Example

# MongoDB Connection String
# Replace with your actual MongoDB connection URI.
# Example for MongoDB Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@<yourcluster.mongodb.net>/<database_name>?retryWrites=true&w=majority
# Example for local MongoDB: MONGODB_URI=mongodb://localhost:27017/<database_name>
MONGODB_URI=

# JSON Web Token (JWT) Secret
# This is used to sign and verify JWTs for authentication.
# Generate a strong, random string (at least 32 characters long).
# You can use the following command in your terminal to generate one:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Nodemailer Configuration (for email functionalities)
# These are required if the application uses Nodemailer to send emails (e.g., for password resets, notifications).

# Admin Email Address
# The email address from which system emails will be sent.
ADMIN_EMAIL=youremail@example.com

# Admin Email Application Password
# If using Gmail with 2FA, this is an "App Password". For other providers, consult their documentation.
ADMIN_EMAIL_APP_PASSWORD=yourapppassword
